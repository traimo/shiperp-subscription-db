# Copy to .env (gitignored). The app runs on PostgreSQL (docker-compose.yml). docker compose sets DATABASE_URL for the
# app container; host-side tools (tests, scripts) build it from POSTGRES_PASSWORD at 127.0.0.1:5433.
# DATABASE_URL=postgresql+psycopg://user:password@host/db   (only to point elsewhere; secrets: Key Vault when deployed)
# APP_USER=your.name        # name written to the audit log (default: Windows user)
# Contract documents are SharePoint links only (the app never connects to SharePoint)
# SP_ALLOWED_HOSTS=yourcompany.sharepoint.com   # optional: only accept links to this host

# Refresh data (header button): read-only Microsoft Graph pull of the two workbooks from SharePoint.
# Entra app with Sites.Selected *read* on the site that holds them; the secret VALUE (not the Secret ID).
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
# SharePoint sharing links of the two workbooks
SP_SUBSCRIPTION_URL=
SP_MAINTENANCE_URL=

# Host names the app answers to (default: 127.0.0.1, localhost). Add a machine name only if it is opened that way.
# APP_ALLOWED_HOSTS=

# Docker / PostgreSQL (docker-compose.yml). Use hex/alphanumeric passwords: they go inside a URL.
# Tests use the throwaway database subs_test in the same container (or TEST_DATABASE_URL).
POSTGRES_PASSWORD=
# Read-only login `dashboard_ro` for the shiperp-dashboard container (created when the DB volume is first set up)
DASHBOARD_DB_PASSWORD=
